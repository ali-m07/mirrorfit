# Copy this file to .env and adjust for your environment.
# Every value here overrides config.yaml (highest precedence).

# --- Camera -----------------------------------------------------------------
ARTRYON__CAMERA__INDEX=0
ARTRYON__CAMERA__WIDTH=1280
ARTRYON__CAMERA__HEIGHT=720

# --- Pose backend (real-time GPU path) ---------------------------------------
# auto  = ONNX/DirectML GPU when available, MediaPipe CPU fallback
# onnx  = force ONNX (hard requirement)   |  mediapipe = force CPU
# ARTRYON__VISION__POSE__BACKEND=auto            # mediapipe (default) | onnx | auto
# ARTRYON__VISION__POSE__ONNX__DEVICE=cpu        # cpu (always correct) | dml (opt-in GPU)
# ARTRYON__VISION__POSE__ONNX__INPUT_SIZE=640
# ARTRYON__VISION__SEGMENTATION__INTERVAL=3      # recompute mask every N frames

# --- API service -------------------------------------------------------------
ARTRYON__API__HOST=0.0.0.0
ARTRYON__API__PORT=8000

# --- Logging -----------------------------------------------------------------
ARTRYON__LOGGING__LEVEL=INFO

# --- Misc --------------------------------------------------------------------
# Comma-separated extra clothing directories (merged into the catalog)
# ARTRYON_EXTRA_CLOTHES_DIRS=
